# Database
DB_HOST=localhost
DB_PORT=5434
DB_NAME=db_labv5_comercial
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:4200

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# SMTP (correo saliente: cotizaciones, soporte, cartas de cierre, reportes)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=soporte@sigesp.com.ve
MAIL_PASS=tu_app_password_de_gmail
MAIL_FROM=soporte@sigesp.com.ve
MAIL_FROM_NAME=SIGESP

# SGH - Adjuntos de actividad (PDF/JPG/PNG)
# Raiz fisica donde se guardan los documentos; vacio = <backend>/storage/actividades
SGH_ACTIVIDADES_STORAGE_ROOT=

# Adjuntos de tickets de Soporte (raiz COMPARTIDA con el portal sigespweb)
# Si se omite, se usa STORAGE_ROOT y, por ultimo, la ruta de desarrollo en Windows.
# En Linux/VPS es OBLIGATORIO apuntar a la carpeta compartida, p. ej.:
#   TICKETS_STORAGE_ROOT=/var/www/html/apisigesp/sigespweb/storage
TICKETS_STORAGE_ROOT=
# Misma variable que usa el portal sigespweb (alternativa a TICKETS_STORAGE_ROOT)
STORAGE_ROOT=

# MantisBT (integracion de tickets y reportes)
MANTIS_BASE_URL=http://tu-servidor/mantis
MANTIS_API_TOKEN=tu_api_token_de_mantis
MANTIS_TIMEOUT_MS=30000
# Alertas de casos estancados (correo diario; vacio = desactivado)
MANTIS_ALERTAS_EMAIL=calidad@sigesp.com.ve
MANTIS_ALERTAS_DIAS=15
# Tope de casos por reporte PDF
MANTIS_REPORTE_MAX=300

# Soporte - Alerta de casos sin atender (> N horas laborables)
SOPORTE_ALERTA_HORAS=24
SOPORTE_ALERTA_CORREO=calidad@sigesp.com.ve
SOPORTE_ALERTA_HORA=8
SOPORTE_ALERTA_CRON_MIN=60
SOPORTE_ALERTA_DIAS=1,2,3,4,5
SOPORTE_ALERTA_TZ=America/Caracas

# Soporte - Copia (CC) del cierre automatico enviado al cliente
# (si se omite, se usa calidad@sigesp.com.ve)
SOPORTE_CALIDAD_EMAIL=calidad@sigesp.com.ve

# Agente IA (OpenCode Zen / cualquier API compatible con OpenAI)
AGENTE_ENABLED=true
AGENTE_API_KEY=tu_api_key_aqui
AGENTE_BASE_URL=https://opencode.ai/zen/v1
AGENTE_MODEL=space-bunny-free
AGENTE_TEMPERATURE=0.2
AGENTE_MAX_STEPS=5
AGENTE_TIMEOUT_MS=60000
